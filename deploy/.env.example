# Pull-only server deploy (.env next to deploy/docker-compose.yml)
# Images come from GitHub Container Registry: no git clone / no --build.

IMAGE_TAG=main
API_IMAGE=ghcr.io/asb131/spotify-self-hosted-clone-api:main
WEB_IMAGE=ghcr.io/asb131/spotify-self-hosted-clone-web:main

# Host ports
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Linux multi-drive layout (adjust to your mounts)
# Compose project dir:  /ssd1_system/docker/spotify_clone
POSTGRES_DATA=/ssd2_cache/databases/spotify_clone_postgres
REDIS_DATA=/ssd2_cache/caches/spotify_clone/redis
APP_DATA=/ssd2_cache/caches/spotify_clone/app
MUSIC_VOLUME=/ssd2_cache/spotify_clone_media
COOKIES_FILE=./cookies.txt

PUID=1000
PGID=1000
TZ=UTC

# Database
POSTGRES_USER=musicapp
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=musicapp

# Security
SECRET_KEY=replace_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# For https://music.asb-servers.com set:
# PUBLIC_WEB_URL=https://music.asb-servers.com
# COOKIE_SECURE=true
# (COOKIE_SECURE also auto-enables when PUBLIC_WEB_URL starts with https://)

# URLs (use your LAN IP or domain)
PUBLIC_WEB_URL=http://YOUR_SERVER_IP:3000
CORS_ORIGINS=http://YOUR_SERVER_IP:3000,http://localhost:3000
NEXT_PUBLIC_API_DIRECT_URL=http://YOUR_SERVER_IP:8000
NEXT_PUBLIC_WS_URL=ws://YOUR_SERVER_IP:8000

# Optional: yt-dlp cookies path inside containers
YTDLP_COOKIES_PATH=/app/cookies.txt
DEFAULT_STORAGE_QUOTA_BYTES=107374182400
