# ─── Host ports (change if these conflict with other services) ───
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ─── Volume paths (absolute or relative on the host) ───
# Example: DB on cache drive, music on bulk storage, app data elsewhere
POSTGRES_DATA=./data/postgres
REDIS_DATA=./data/redis
MUSIC_VOLUME=./data/music
APP_DATA=./data/app
COOKIES_FILE=./cookies.txt

# ─── Database ───
POSTGRES_USER=musicapp
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=musicapp
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# ─── Redis / Celery ───
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Security (generate with: openssl rand -hex 32) ───
SECRET_KEY=replace_with_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ─── CORS (comma-separated origins) ───
CORS_ORIGINS=http://localhost:3000,chrome-extension://YOUR_EXTENSION_ID

# ─── Frontend (browser-visible API URL) ───
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─── Pre-built images (GitHub Container Registry) ───
# Leave IMAGE_TAG=main or set a release tag. Use empty build-only: API_IMAGE= WEB_IMAGE=
IMAGE_TAG=main
API_IMAGE=ghcr.io/asb131/spotify-self-hosted-clone-api:main
WEB_IMAGE=ghcr.io/asb131/spotify-self-hosted-clone-web:main

# ─── Spotify sync (optional, per-user tokens stored in DB) ───
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/v1/spotify/callback
PUBLIC_WEB_URL=http://localhost:3000

# ─── Download defaults ───
DEFAULT_AUDIO_FORMAT=mp3
YTDLP_COOKIES_PATH=/app/cookies.txt
FFMPEG_PATH=ffmpeg

# ─── Admin defaults ───
DEFAULT_STORAGE_QUOTA_BYTES=10737418240
